{
  "expo": {
    "name": "ReLink AI Mobile",
    "slug": "relink",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "relink-mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.relinkapp.mobile",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "url": "https://ai-agent-tool-mikam514.replit.app/relink-mobile"
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "android": {
      "package": "com.relinkapp.mobile"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "./plugins/withPackagingFix"
    ],
    "extra": {
      "eas": {
        "projectId": "d237d405-027c-4c5b-aad7-62157de0d65a"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "mikam516"
  }
}
